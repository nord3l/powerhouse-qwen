#!/usr/bin/env bash
# Prints the /review reviewers that apply to the current changes, one per line, so /review
# doesn't spend tokens on reviewers with nothing to look at.
#
#   select-reviewers [base-ref] [--all]
#
# Changes = committed + uncommitted diff against the merge base with base-ref (default: origin/main,
# then main, origin/master, master; origin first because a local main is often stale), plus
# untracked files.
#   security-reviewer, test-gap-reviewer   always
#   iac-reviewer                           Terraform (*.tf, *.tfvars, *.hcl)
#   k8s-reviewer                           Kubernetes/Helm/Kustomize files, or Terraform that mentions EKS
#   war-reviewer                           any infrastructure: Terraform, Kubernetes, workflows, Docker
#   frugal-reviewer                        Terraform, Kubernetes or workflows
# Fails safe: with --all, an unknown base ref, or outside a repo, it prints all six.
set -u

ALL=(security-reviewer iac-reviewer k8s-reviewer war-reviewer test-gap-reviewer frugal-reviewer)
all() { printf '%s\n' "${ALL[@]}"; exit 0; }

base=""
for arg in "$@"; do
  case "$arg" in
    --all) all ;;
    *) base="$arg" ;;
  esac
done

git rev-parse --git-dir >/dev/null 2>&1 || all
cd "$(git rev-parse --show-toplevel)" || all
if [ -n "$base" ]; then
  git rev-parse --verify -q "$base^{commit}" >/dev/null || all
else
  for ref in origin/main main origin/master master; do
    if git rev-parse --verify -q "$ref^{commit}" >/dev/null; then base=$ref; break; fi
  done
  [ -n "$base" ] || all
fi

tf=0 k8s=0 workflows=0 docker=0
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
    *.tf|*.tfvars|*.hcl|*.tf.json)
      tf=1
      if [ -f "$f" ] && grep -qiE 'aws_eks_|eks/aws|karpenter' "$f"; then k8s=1; fi ;;
    .github/workflows/*|.github/actions/*) workflows=1 ;;
    Dockerfile*|*/Dockerfile*|*.dockerfile|docker-compose*.y*ml|*/docker-compose*.y*ml|compose.y*ml|*/compose.y*ml) docker=1 ;;
    k8s/*|*/k8s/*|charts/*|*/charts/*|manifests/*|*/manifests/*|helm/*|*/helm/*|kustomize/*|*/kustomize/*) k8s=1 ;;
    Chart.yaml|*/Chart.yaml|kustomization.y*ml|*/kustomization.y*ml) k8s=1 ;;
    *.yaml|*.yml)
      if [ -f "$f" ] && grep -qE '^apiVersion:' "$f" && grep -qE '^kind:' "$f"; then k8s=1; fi ;;
  esac
done < <({ git diff --merge-base "$base" --name-only 2>/dev/null; git ls-files --others --exclude-standard; } | sort -u)

echo security-reviewer
[ "$tf" -eq 1 ] && echo iac-reviewer
[ "$k8s" -eq 1 ] && echo k8s-reviewer
[ $((tf + k8s + workflows + docker)) -gt 0 ] && echo war-reviewer
echo test-gap-reviewer
[ $((tf + k8s + workflows)) -gt 0 ] && echo frugal-reviewer
exit 0
